# ===========================================
# SUPABASE (required — lấy từ Supabase Dashboard > Project Settings > API)
# ===========================================
NEXT_PUBLIC_SUPABASE_URL=https://jlunopjpwxhvpbekiprn.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ===========================================
# GOOGLE MAPS (required — lấy từ GCP > APIs & Services > Credentials)
# ===========================================
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Map ID từ GCP > Google Maps Platform > Map management (cần cho AdvancedMarkerElement)
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# ===========================================
# AI (cần từ Week 7 — AI fill scripts)
# ===========================================
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ===========================================
# GEMINI FLASH (enrichment pipeline, S08-replacement)
# ===========================================
# Lấy free key tại https://aistudio.google.com/apikey
# Vietnam region free tier (verified 2026-05-19):
#   - gemini-2.5-flash       : 20 RPD/key  (quá ít — chỉ dùng nếu paid Tier 1)
#   - gemini-2.5-flash-lite  : ~1000 RPD/key  (default, đủ cho 10k dự án trong 1 ngày)
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
# Model. Default flash-lite; set =gemini-2.5-flash nếu mày upgrade paid Tier 1.
GEMINI_MODEL=gemini-2.5-flash-lite
# Per-key daily budget. Default 950 (under flash-lite ~1000 RPD).
# Paid Tier 1: set =10000.
GEMINI_RPD_PER_KEY=950
# Cron tuning
GEMINI_BATCH_SIZE=5          # dự án/Gemini call
GEMINI_BATCHES_PER_TICK=3    # số batch trong 1 cron tick (5×3=15 dự án/2 phút)
# Kill-switch — set =true để cron chạy. Default paused.
ENRICH_ENABLED=false

# ===========================================
# TTS (cần trước Phase 1)
# ===========================================
VBEE_API_KEY=

# ===========================================
# PAYMENTS (cần Phase 2 — Week 17+)
# ===========================================
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=

# ===========================================
# INTERNAL CONFIG
# ===========================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Random 32-char string — dùng để verify Vercel Cron requests
CRON_SECRET=
